PORT=3050

# App creada en Partners Nube.
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=
TIENDANUBE_AUTH_BASE=https://www.tiendanube.com
APP_BASE_URL=http://localhost:3050
APP_PASSWORD=
COOKIE_SECRET=

# Se completan automaticamente despues de autorizar la tienda.
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=

# Identifica esta integracion en el User-Agent.
APP_CONTACT_EMAIL=

# Cache local para que la segunda carga del mismo periodo sea rapida.
STATS_CACHE_TTL_MS=21600000
STATS_CACHE_DIR=.cache/stats
PRODUCT_CACHE_TTL_MS=604800000
PRODUCT_CACHE_DIR=.cache/products
