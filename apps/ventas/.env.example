# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo como ".env" y completá los valores reales.
# NUNCA subas .env a Git ni lo compartas.
# ─────────────────────────────────────────────────────────────────────────────

# Puerto en que corre el servidor local (por defecto: 3000)
PORT=3000

# Proteccion de acceso para produccion.
# Si APP_PASSWORD esta vacia, la app no pide login.
APP_PASSWORD=
APP_SESSION_SECRET=

# ── Credenciales OAuth de Tiendanube ─────────────────────────────────────────
# Obtenenlas en: https://partners.tiendanube.com  →  Tu aplicación → Credenciales
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=

# URI de callback registrada en el panel de la app de Tiendanube.
# Para desarrollo local: http://localhost:3000/auth/tiendanube/callback
TIENDANUBE_REDIRECT_URI=http://localhost:3000/auth/tiendanube/callback

# ── Credenciales de la tienda (post-OAuth) ────────────────────────────────────
# TIENDANUBE_STORE_ID   → campo "user_id" de la respuesta del token
# TIENDANUBE_ACCESS_TOKEN → campo "access_token" de la respuesta del token
#
# Para obtenerlos:
#   1. Completá CLIENT_ID, CLIENT_SECRET y REDIRECT_URI.
#   2. Abrí en el navegador: http://localhost:3000/auth/tiendanube
#   3. Autorizá la app en Tiendanube.
#   4. Copiá los valores que aparecen en pantalla después del callback.
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=

# Integracion con la app de stock.
DECREMENT_SECRET=
STOCK_DECREMENT_URL=https://incognito-stock.netlify.app/.netlify/functions/decrement-stock
STOCK_LIST_URL=https://incognito-stock.netlify.app/.netlify/functions/list-stock-items

# Mercado Pago. Usado por /api/mercadopago/releases para completar cobros MP
# desde la app contable. Guardar solo en Render/local, nunca en el frontend.
MERCADOPAGO_ACCESS_TOKEN=

# Backup automatico de la app contable desde este backend.
# Reutiliza las credenciales Microsoft/SharePoint de ventas.
SHAREPOINT_CONTABLE_AUTO_BACKUP=true
CONTABLE_SUPABASE_URL=https://hspvuakueakgeffiyjzm.supabase.co
CONTABLE_SUPABASE_SERVICE_ROLE_KEY=
CONTABLE_SUPABASE_ANON_KEY=
SHAREPOINT_CONTABLE_BACKUP_PATH=Incognito/Incognito - Documentos/Contabilidad y Finanzas/Dashboard/backup-historico-contable.xls
SHAREPOINT_CONTABLE_FULL_BACKUP_PATH=Incognito/Incognito - Documentos/Contabilidad y Finanzas/Dashboard/backup-completo-incognito-contable.json

# Motor de envio de plantillas WhatsApp.
# meta = usa WhatsApp Cloud API como hasta ahora.
# kommo = busca/crea contacto y lead en Kommo y lanza Salesbots.
WHATSAPP_SEND_ENGINE=meta
KOMMO_TEST_ENABLED=false
KOMMO_TEST_PHONE_ALLOWLIST=

# WhatsApp Cloud API / Meta
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_TRACKING_NAME=
WHATSAPP_TEMPLATE_FLUX_NAME=
WHATSAPP_TEMPLATE_CONFIRMATION_NAME=
WHATSAPP_TEMPLATE_CONFIRMATION_CASH_NAME=
WHATSAPP_TEMPLATE_ORDER_CONTACT_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es

# Kommo. No guardar el token real en el repo.
KOMMO_SUBDOMAIN=incognitoindumentaria
KOMMO_ACCESS_TOKEN=
KOMMO_FIELD_TN_ID=2443342
KOMMO_FIELD_NOMBRE_TN_ID=2443344
KOMMO_BOT_CONFIRMACION_FLUX_ID=102514
KOMMO_BOT_CONTACTO_PEDIDO_ID=102516
KOMMO_BOT_FLUX_SIN_ABONAR_ID=102520
KOMMO_BOT_FLUX_ABONADO_ID=102522
KOMMO_DUPLICATE_WINDOW_MS=120000
